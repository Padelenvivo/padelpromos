{
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/generador", "destination": "/generador.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/club/:token", "destination": "/club/index.html" }
  ],
  "crons": [
    {
      "path": "/api/newsletter-semanal",
      "schedule": "0 8 * * 1"
    }
  ]
}
